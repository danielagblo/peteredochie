{
  "name": "monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently --kill-others --raw \"npm run dev -w web\" \"npm run dev -w api\"",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build -w web",
    "start": "npm run start -w api",
    "migrate": "npm run migrate -w api",
    "lint": "concurrently --raw \"npm run lint -w web\" \"npm run lint -w api\""
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "knip": "^6.32.1"
  },
  "workspaces": [
    "apps/*"
  ]
}
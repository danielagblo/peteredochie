PORT=3001
# Comma-separated origins allowed to call this API (e.g. http://localhost:3000 or your domain). Leave empty to deny all.
CORS_ORIGIN=
# Paystack secret key (test_sk_... or sk_live_...) from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=
# MySQL connection string: mysql://user:password@host:port/database
DATABASE_URL=
# JWT secret used for signing auth tokens (change in production!)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Email Delivery — Gmail API (OAuth2). Sends over HTTPS and therefore bypasses
# Railway's outbound SMTP port blocking. Step up a Google Cloud project with the
# Gmail API enabled, create an OAuth 2.0 Client ID (Desktop app), and generate a
# refresh token for the gmail scope (https://mail.google.com/). Leave unset to
# fall back to SMTP, or fully unset for dev simulation mode.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=me
# The address emails are sent from (OAuth account or a branded address).
EMAIL_FROM="The Pete Edochie Legacy <newsletter@peteredochie.com>"

# Legacy generic SMTP (only used if Gmail API is NOT configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

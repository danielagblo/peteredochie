PORT=3001
# Comma-separated origins allowed to call this API (e.g. http://localhost:3000 or your domain). Leave empty to deny all.
CORS_ORIGIN=
# Paystack secret key (test_sk_... or sk_live_...) from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=
# PocketBase superuser (used for server-side order/ticket verification and stock)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
POCKETBASE_URL=http://localhost:8090
